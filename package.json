{
  "name": "freelancer-os",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm turbo run build",
    "dev": "pnpm turbo run dev",
    "lint": "pnpm turbo run lint",
    "typecheck": "pnpm turbo run typecheck",
    "db:generate": "pnpm --filter @freelancer-os/db db:generate",
    "db:migrate": "pnpm --filter @freelancer-os/db db:migrate",
    "format": "prettier --write \"**/*.{ts,tsx,md,css,json}\""
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.0.0"
  }
}
